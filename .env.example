# MuseGuide Environment Variables
# Copy this file to .env and fill in values as needed.

# Cleveland Museum of Art API (no key required - public open access)
CMA_API_BASE_URL=https://openaccess-api.clevelandart.org/api

# Optional: For future Cloud LLM integration (Milestone 3)
# MuseGuide works 100% offline out-of-the-box without any API keys.
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
