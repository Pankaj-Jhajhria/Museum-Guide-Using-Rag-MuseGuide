# MuseGuide Environment Variables
# Copy this file to .env and fill in values as needed.

# Cleveland Museum of Art API (no key required - public open access)
CMA_API_BASE_URL=https://openaccess-api.clevelandart.org/api

# Groq Cloud LLM Configuration (Optional)
# MuseGuide works 100% offline out-of-the-box using the extractive synthesizer without an API key.
# To enable natural, conversational Groq LLM answer generation:
# 1. Sign up for a free Groq account at https://console.groq.com
# 2. Generate an API key under API Keys
# 3. Set the key below and configure your preferred model
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Answer Generator Backend: 'auto', 'groq', or 'extractive'
# - auto: Uses Groq if GROQ_API_KEY is configured, else falls back to offline extractive docent
# - groq: Forces Groq LLM (falls back to offline if API request fails)
# - extractive: Forces 100% offline deterministic docent synthesis
RAG_GENERATOR=auto

# Optional: Other LLM Providers
# OPENAI_API_KEY=your_openai_api_key_here
